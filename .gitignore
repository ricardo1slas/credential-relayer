# Private / sensitive files
.profile.md
.env
.env.*
configs/config.yaml

# Build output
bin/
/relayer

# Large installers (never belong in git)
*.pkg

# OS files
.DS_Store

# IDE
.idea/
.vscode/
*.swp

# Security scanner reports
trivy-report.json
gitleaks-report.json

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
infra/terraform/**/terraform.tfvars
!infra/terraform/**/terraform.tfvars.example

# Personal notes / AI-assistant context (kept locally, never published)
/private/

# Scratch file holding a key (never commit)
.text.text
