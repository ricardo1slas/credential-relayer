# Copy to local.mk (gitignored) and fill in; read by the Makefile.
# Keep comments on their own lines: Make keeps trailing spaces before an inline "#".

# make deploy-pi / make bench
PI = <user>@<pi-host>
# make traffic: relayer address and a file holding a key allowed to use the httpbin target
export RELAYER_URL = http://<pi-tailnet-ip>:8080
export RELAYER_API_KEY_FILE = ~/.config/credential-relayer/dev-client.key
# make publish-check / publish: scrubbed export for the public repository
export PUBLISH_REPLACEMENTS = ~/.config/credential-relayer/publish-replacements.txt
# optional: publish commits under a GitHub no-reply email ("Name <new> <old>" per line)
# export PUBLISH_MAILMAP = ~/.config/credential-relayer/publish-mailmap.txt
export PUBLIC_REMOTE = git@github.com:<you>/credential-relayer.git
