{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Private Relayer",
  "uid": "private-relayer",
  "tags": ["relayer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate (req/s by route)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (route) (rate(relayer_http_requests_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP error rate (4xx/5xx %)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "expr": "100 * sum(rate(relayer_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(relayer_http_requests_total[5m])), 1)",
          "legendFormat": "5xx %"
        },
        {
          "expr": "100 * sum(rate(relayer_http_requests_total{status=~\"4..\"}[5m])) / clamp_min(sum(rate(relayer_http_requests_total[5m])), 1)",
          "legendFormat": "4xx %"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(relayer_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(relayer_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(relayer_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 4,
      "title": "Relay outcomes (per target)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (target, outcome) (rate(relayer_relay_requests_total[1m]))",
          "legendFormat": "{{target}} {{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pending queue depth",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "relayer_queue_depth", "legendFormat": "depth" }]
    },
    {
      "id": 6,
      "title": "Jobs processed (rate by status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 6, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(relayer_jobs_processed_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Relay attempts p95 (per target)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, target) (rate(relayer_relay_attempts_bucket[5m])))",
          "legendFormat": "{{target}}"
        }
      ]
    }
  ]
}
