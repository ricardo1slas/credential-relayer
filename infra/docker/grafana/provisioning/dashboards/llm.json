{
  "uid": "relayer-llm",
  "title": "Relayer \u00b7 LLM & upstreams",
  "description": "Streaming latency (time to first byte), upstream outcomes and quota exhaustion.",
  "tags": [
    "relayer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "query": {
          "query": "label_values(relayer_upstream_responses_total, target)",
          "refId": "v"
        },
        "definition": "label_values(relayer_upstream_responses_total, target)"
      }
    ]
  },
  "panels": [
    {
      "id": 9,
      "title": "Median time to first byte",
      "type": "stat",
      "description": "Proxy streams: request in to first response byte out. For an LLM this is time to first token, the latency people feel.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (increase(relayer_stream_ttfb_seconds_bucket{target=~\"$target\"}[$__range])))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 10,
      "title": "p95 time to first byte",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(relayer_stream_ttfb_seconds_bucket{target=~\"$target\"}[$__range])))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 11,
      "title": "Upstream success",
      "type": "stat",
      "description": "Share of upstream calls answered with 2xx.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(relayer_upstream_responses_total{target=~\"$target\",code=~\"2..\"}[$__range])) / sum(increase(relayer_upstream_responses_total{target=~\"$target\"}[$__range]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 12,
      "title": "Quota hits (upstream 429)",
      "type": "stat",
      "description": "The upstream refused for rate/quota (free tiers). Zero is good.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(relayer_upstream_responses_total{target=~\"$target\",code=\"429\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 13,
      "title": "Time to first byte: distribution over time",
      "type": "heatmap",
      "description": "Each column is a time slice, each cell a latency bucket; darker = more streams. A shift up means the upstream (or the Pi) got slower for everyone, a separate band means two populations (e.g. thinking vs non-thinking calls).",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(relayer_stream_ttfb_seconds_bucket{target=~\"$target\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 2,
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "le"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Blues",
          "fill": "#3987e5",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64,
          "reverse": false,
          "min": 0
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": true
        },
        "cellValues": {
          "unit": "short",
          "decimals": 0
        },
        "exemplars": {
          "color": "#898781"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Time to first byte: p50 and p95",
      "type": "timeseries",
      "description": "Emphasis: the tail (p95) in blue, the median in gray.",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(relayer_stream_ttfb_seconds_bucket{target=~\"$target\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(relayer_stream_ttfb_seconds_bucket{target=~\"$target\"}[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "none",
            "axisBorderShow": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 15,
      "title": "Upstream outcomes by status class",
      "type": "timeseries",
      "description": "Calls per minute, stacked. Status colors carry state; every class is also labeled.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(relayer_upstream_responses_total{target=~\"$target\",code=~\"2..\"}[$__rate_interval])) * 60",
          "legendFormat": "2xx OK"
        },
        {
          "refId": "B",
          "expr": "sum(rate(relayer_upstream_responses_total{target=~\"$target\",code=~\"4..\"}[$__rate_interval])) * 60",
          "legendFormat": "4xx client error (incl. 429)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(relayer_upstream_responses_total{target=~\"$target\",code=~\"5..|error\"}[$__rate_interval])) * 60",
          "legendFormat": "5xx / no response"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "none",
            "axisBorderShow": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx OK"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0ca30c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx client error (incl. 429)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fab219"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx / no response"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      }
    },
    {
      "id": 16,
      "title": "Quota exhaustion (upstream 429s)",
      "type": "timeseries",
      "description": "Free tiers answer 429 when the per-minute or daily quota is used up. Alert: UpstreamQuotaExhausted.",
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(relayer_upstream_responses_total{target=~\"$target\",code=\"429\"}[$__rate_interval])) * 60 or vector(0)",
          "legendFormat": "429s / min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "none",
            "axisBorderShow": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#ec835a"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 17,
      "title": "Stream duration: p50 and p95",
      "type": "timeseries",
      "description": "Full response time of proxied streams (first byte to last). Must stay under the target's timeout.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(relayer_stream_duration_seconds_bucket{target=~\"$target\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(relayer_stream_duration_seconds_bucket{target=~\"$target\"}[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "none",
            "axisBorderShow": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 18,
      "title": "Bytes streamed per target",
      "type": "bargauge",
      "description": "Response volume sent to clients over the selected range.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (target) (increase(relayer_stream_bytes_total{target=~\"$target\"}[$__range])))",
          "legendFormat": "{{target}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "namePlacement": "left",
        "valueMode": "text",
        "sizing": "auto",
        "maxVizHeight": 28,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": "/^Value$/"
        }
