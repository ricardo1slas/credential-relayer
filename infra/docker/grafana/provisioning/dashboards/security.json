{
  "uid": "relayer-security",
  "title": "Relayer \u00b7 Security & usage",
  "description": "What the gate refused and which relayer key used what.",
  "tags": [
    "relayer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "key",
        "label": "Key",
        "type": "query",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "query": {
          "query": "label_values(relayer_upstream_responses_total, key)",
          "refId": "v"
        },
        "definition": "label_values(relayer_upstream_responses_total, key)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Upstream calls",
      "type": "stat",
      "description": "Calls that passed every check and reached an upstream, over the selected range.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(relayer_upstream_responses_total[$__range]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "Refused by policy or scope",
      "type": "stat",
      "description": "Stopped by Authorize before anything left the Pi: key scope, method, path, body size, unknown target.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(relayer_rejections_total[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "title": "Auth failures (401)",
      "type": "stat",
      "description": "Missing or invalid relayer key.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(relayer_http_requests_total{status=\"401\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "title": "Rate-limited (429 from the relayer)",
      "type": "stat",
      "description": "Per-key token bucket exceeded. Upstream 429s (e.g. Gemini quota) are on the LLM dashboard.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(relayer_http_requests_total{status=\"429\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "title": "Refusals by reason",
      "type": "bargauge",
      "description": "What the gate stopped, largest first. scope = key not allowed to use the target; method/path/body = target policy; not_found = unknown target; bad_path / bad_method = malformed request.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (reason) (increase(relayer_rejections_total[$__range])))",
          "legendFormat": "{{reason}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "namePlacement": "left",
        "valueMode": "text",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 28,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true,
          "fields": "/^Value$/"
        }
      }
    },
    {
      "id": 6,
      "title": "Refusals over time",
      "type": "timeseries",
      "description": "All reasons combined; the bar chart on the left breaks the range down.",
      "gridPos": {
        "x": 10,
        "y": 4,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(relayer_rejections_total[$__rate_interval])) * 60",
          "legendFormat": "refusals / min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "none",
            "axisBorderShow": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 7,
      "title": "Per-key usage",
      "type": "table",
      "description": "Who used what over the selected range. Calls reached the upstream; failed = 5xx or no response; refused = stopped by the gate.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (key, target) (increase(relayer_upstream_responses_total[$__range]))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (key, target) (increase(relayer_upstream_responses_total{code=~\"5..|error\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by (key, target) (increase(relayer_rejections_total[$__range]))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "sum by (key, target) (increase(relayer_stream_bytes_total[$__range]))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "key": "Key",
              "target": "Target",
              "Value #A": "Calls",
              "Value #B": "Failed",
              "Value #C": "Refused",
              "Value #D": "Streamed"
            },
            "indexByName": {
              "key": 0,
              "target": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Calls",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Streamed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Key"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Key"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "title": "Calls per minute: $key",
      "type": "timeseries",
      "description": "Emphasis: calls in blue, refusals in gray.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(relayer_upstream_responses_total{key=\"$key\"}[$__rate_interval])) * 60",
          "legendFormat": "calls"
        },
        {
          "refId": "B",
          "expr": "sum(rate(relayer_rejections_total{key=\"$key\"}[$__rate_interval])) * 60",
          "legendFormat": "refused"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "none",
            "axisBorderShow": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "refused"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "repeat": "key",
      "repeatDirection": "h",
      "maxPerRow": 3
    }
  ]
}